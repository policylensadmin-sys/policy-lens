# =============================================================================
# PolicyLens environment configuration
# Copy this file to `.env` and fill in values. Leave provider keys blank to
# run entirely on deterministic mock adapters (no external keys required).
# =============================================================================

# --- Server -----------------------------------------------------------------
PORT=8080
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase ---------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # backend only — never ship to the client
SUPABASE_JWT_SECRET=
DATABASE_URL=                       # Postgres connection string for `npm run migrate` (Supabase: Project Settings → Database)

# --- AI provider (leave blank / set to mock to use the mock adapter) --------
AI_PROVIDER=mock                    # anthropic | openai | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Embedding provider -----------------------------------------------------
EMBEDDING_PROVIDER=mock             # openai | mock
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- OCR provider -----------------------------------------------------------
OCR_PROVIDER=mock                   # google | mock
GOOGLE_VISION_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=     # path to service-account JSON (google mode)

# --- Limits -----------------------------------------------------------------
MAX_UPLOAD_MB=20
FREE_TIER_UPLOAD_LIMIT=3
JOB_MAX_ATTEMPTS=3
JOB_CONCURRENCY_PER_USER=5

# --- Frontend (Vite — must be prefixed with VITE_) --------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_BASE_URL=http://localhost:8080/api
